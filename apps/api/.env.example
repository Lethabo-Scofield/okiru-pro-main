# ─── Google Analytics (GA4 Data API) + Search Console ────────────────────────
# Server-side only. NEVER expose these to frontend code and do NOT prefix them
# with a public-client prefix (e.g. VITE_). Leave blank to disable analytics —
# the /admin/analytics page will show a "not connected" message and the app
# will keep working normally.
#
# NOTE: The GA4 numeric Property ID is DIFFERENT from the website measurement
# ID (G-WF69VTV757). The measurement ID is only used by the public tracking tag
# in apps/web/index.html — do NOT put it here.
GOOGLE_ANALYTICS_PROPERTY_ID=YOUR_NUMERIC_GA4_PROPERTY_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# Paste the full private key. Escaped newlines (\n) are handled automatically.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="YOUR_PRIVATE_KEY"
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:okiru.pro

# ─── okiru-ai-parser integration ─────────────────────────────────────────────
# Base URL of the okiru-ai-parser service. When unset, defaults to
# http://127.0.0.1:3200 in non-production.
PARSER_SERVICE_URL=http://127.0.0.1:3200
PARSER_TIMEOUT_MS=30000
# Verifies the parser's signature on each run filed into the document library
# (both the rule layer and the model/agent values). MUST match
# PARSER_INTERNAL_SECRET in the parser's and the web app's environment. Blank
# means every browser-filed run is refused (fails closed).
PARSER_INTERNAL_SECRET=
# A paid re-read (rules + model + agent) of one file. Default 540000 — under
# the 600s idle limit of the ingress and the web proxy.
PARSER_FILE_TIMEOUT_MS=540000

# Certificate Hub Blob Storage (server-side only)
# Production uses DefaultAzureCredential with AKS managed/workload identity.
# Do not expose these through VITE_* variables and do not commit storage keys.
AZURE_STORAGE_ACCOUNT_NAME=okirubackups2026
AZURE_STORAGE_ACCOUNT_URL=https://okirubackups2026.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=certificates
AZURE_STORAGE_SAS_EXPIRY_SECONDS=300
# Optional local-development fallback only:
# AZURE_CERT_STORAGE_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Rules Studio (see docs/rules-studio/README.md). Nothing here has a default key.
# ---------------------------------------------------------------------------
# Production publishing stays OFF until every launch prerequisite is met. While false,
# /api/rules answers {launched:false} and every client uses the shipped rules.
RULES_LAUNCHED=false
# Operator kill-switch independent of the Studio UI: true blocks publishing everywhere.
RULES_FREEZE=false
# Identifies the running build on every version and stamp (set to the git SHA in CI).
BUILD_ID=
# Dedicated Ed25519 signing key (PKCS#8 PEM; "\n" escapes allowed). NOT any other secret.
# Generate: node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'pem'}))"
RULES_SIGNING_KEY_ID=
RULES_SIGNING_PRIVATE_KEY=
# JSON {"keyId":"SPKI PEM"} of RETIRED keys so old versions keep verifying after rotation.
RULES_SIGNING_PUBLIC_KEYS=
# 32-byte base64 key that encrypts TOTP secrets at rest. Without it step-up (and so protected actions) is unavailable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RULES_TOTP_ENC_KEY=
# User ids allowed to create the first Studio grants (admin actions only; not approvers).
RULES_STUDIO_BOOTSTRAP_ADMINS=
# Independent approvals required before publishing (owner decision; default 1).
RULES_REQUIRED_APPROVALS=1
# Off-site backup: MUST be a different subscription/storage account from the primary, container with an immutability policy.
RULES_OFFSITE_AZURE_CONNECTION_STRING=
RULES_OFFSITE_CONTAINER=
# Critical alarms are POSTed here (JSON). In-app notifications work without it.
RULES_ALARM_WEBHOOK_URL=
# Optional AI assistance; disabled without a key. Only rule metadata and the user's sentence are sent.
RULES_AI_API_KEY=
RULES_AI_MODEL=
