# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=
SESSION_SECRET=

# Public origin, used to build PayFast return/cancel/notify URLs.
PUBLIC_BASE_URL=https://okiru.pro

# ── Upstreams ────────────────────────────────────────────────────────────
API_SERVER_URL=http://127.0.0.1:3000
PARSER_SERVICE_URL=http://127.0.0.1:3200

# ── Credit tokens ────────────────────────────────────────────────────────
# Extraction is paid for with credit tokens, not a card at the point of use.
# apps/web debits the organisation's wallet and then tells the parser's
# extraction gate that the batch is settled. This secret authenticates that
# server-to-server call and MUST match PARSER_INTERNAL_SECRET in the parser's
# environment. Blank here means no batch can ever be authorised (fails closed).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARSER_INTERNAL_SECRET=

# How many tokens one ZAR cent of quoted processing costs. At 1, the free
# 10 000-token grant is worth R100 of document reading. One knob, one meaning —
# change it here and every price, quote and balance follows.
# Whether uploads are charged for at all. Defaults to CHARGING; only an
# explicit "false" makes them free. Must be kept in step with the parser's
# PARSER_REQUIRE_PAYMENT — free here + required there refuses every upload.
# Currently "false" in production: the wallet shipped before PayFast, so
# there is no way to buy tokens yet.
TOKENS_REQUIRE_PAYMENT=

TOKENS_PER_CENT=1

# ── PayFast (token purchases) ────────────────────────────────────────────
# Unconfigured merchant credentials fail CLOSED: checkout throws rather than
# handing out tokens. Card data never reaches this app.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
# Where PayFast POSTs the purchase ITN. Must be publicly reachable in production.
PAYFAST_TOKENS_NOTIFY_URL=

# Development-only escape hatch: settle a token order without PayFast so the
# buy flow can be walked before live keys exist. Ignored when NODE_ENV=production.
TOKENS_ALLOW_SIMULATED_PURCHASE=false
