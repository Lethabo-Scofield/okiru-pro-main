{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "parser/**/*.ts", "graph/**/*.ts", "schemas/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
