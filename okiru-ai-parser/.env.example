# ── Service ──────────────────────────────────────────────────────────────
PORT=3200
LOG_LEVEL=INFO
NODE_ENV=development

# Protects POST /api/parser/load-ontology. REQUIRED in production; without it
# the load-ontology route returns 503. In non-production it may be left blank.
PARSER_ADMIN_TOKEN=

# ── Extraction gate: the credit wallet ───────────────────────────────────
# Extraction is authorised by a token debit in apps/web, which then calls
# POST /api/parser/quotes/:id/settle to open the gate. This shared secret is
# what proves that call came from apps/web and not from a browser.
#
# MUST match PARSER_INTERNAL_SECRET in the web app's environment. When it is
# blank the settle route returns 404 — so leaving it unset in production does
# not make extraction free, it makes extraction impossible. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARSER_INTERNAL_SECRET=

# Whether extraction requires a settled quote at all. Defaults to ON; only an
# explicit "false" opens it (local dev / the free manual path).
PARSER_REQUIRE_PAYMENT=

# ── Neo4j parser ontology graph ──────────────────────────────────────────
# Leave blank to run on the bundled in-memory ontology fallback (dev only).
# If set but unreachable, the service falls back to in-memory automatically
# unless PARSER_REQUIRE_NEO4J=true (then it surfaces a hard error in prod).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_CONNECTION_TIMEOUT_MS=10000
NEO4J_QUERY_TIMEOUT_MS=15000
NEO4J_RETRY_TIME_MS=8000
# Set true to make Neo4j mandatory in production (no in-memory fallback).
PARSER_REQUIRE_NEO4J=false

# ── Ontology matrix ──────────────────────────────────────────────────────
# Path to the Excel matrix used to build the ontology. Defaults to the bundled
# ontology/BBBEE_Verification_Document_Matrix_v3.xlsx when unset.
ONTOLOGY_MATRIX_PATH=

# ── Upload & extraction limits (resource-exhaustion guards) ──────────────
PARSER_EXTRACTION_TIMEOUT_MS=60000
PARSER_MAX_PDF_PAGES=100
PARSER_MAX_SHEET_ROWS=20000
PARSER_MAX_IMAGE_BYTES=15728640
PARSER_JSON_BODY_LIMIT=25mb

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this service FROM A BROWSER.
#
# Normally leave this blank. Deployed, /api/parser/* is served on the web app's
# own host and proxied server-to-server, so browser calls are same-origin and
# never hit CORS; the PayFast ITN is server-to-server too. Blank therefore means
# CLOSED in production (no browser origin allowed) and OPEN outside it, so a
# local dev client on another port still works.
#
# Set it only to open a specific origin on purpose. Do not set it to "*".
PARSER_ALLOWED_ORIGINS=

# ── Scanned documents: OCR sidecar (optional) ────────────────────────────
# A long-document OCR model behind an OpenAI-compatible API. Reference:
# Baidu Unlimited-OCR (MIT), served with the vLLM image below on any host with
# an NVIDIA GPU (>=8GB VRAM):
#
#   docker run --rm --gpus all --network host --ipc host \
#     vllm/vllm-openai:unlimited-ocr baidu/Unlimited-OCR --trust-remote-code \
#     --logits_processors vllm.model_executor.models.unlimited_ocr:NGramPerReqLogitsProcessor \
#     --no-enable-prefix-caching --mm-processor-cache-gb 0
#
# UNSET = disabled; scanned PDFs use the Azure vision deployment exactly as
# before. When set, it is tried FIRST and Azure remains the fallback.
PARSER_OCR_ENDPOINT=
PARSER_OCR_MODEL=baidu/Unlimited-OCR
PARSER_OCR_API_KEY=
PARSER_OCR_TIMEOUT_MS=300000

# Pages per call on the Azure vision FALLBACK. Bounds the per-call output
# ceiling so a long scan cannot be silently truncated mid-document.
PARSER_VISION_PAGES_PER_CALL=2
PARSER_MAX_VISION_PAGES=60

# -- Scanned documents: OCR sidecar (optional) ----------------------------
# A long-document OCR model behind an OpenAI-compatible API. Reference:
# Baidu Unlimited-OCR (MIT), served with the vLLM image below on any host with
# an NVIDIA GPU (>=8GB VRAM):
#
#   docker run --rm --gpus all --network host --ipc host \
#     vllm/vllm-openai:unlimited-ocr baidu/Unlimited-OCR --trust-remote-code \
#     --logits_processors vllm.model_executor.models.unlimited_ocr:NGramPerReqLogitsProcessor \
#     --no-enable-prefix-caching --mm-processor-cache-gb 0
#
# UNSET = disabled; scanned PDFs use the Azure vision deployment exactly as
# before. When set it is tried FIRST, with Azure remaining the fallback.
PARSER_OCR_ENDPOINT=
PARSER_OCR_MODEL=baidu/Unlimited-OCR
PARSER_OCR_API_KEY=
PARSER_OCR_TIMEOUT_MS=300000

# Pages per call on the Azure vision FALLBACK. Bounds the per-call output
# ceiling so a long scan cannot be silently truncated mid-document.
PARSER_VISION_PAGES_PER_CALL=2
PARSER_MAX_VISION_PAGES=60
