{
  "name": "okiru-ai-parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:matrix": "node scripts/generate-document-matrix.mjs",
    "eval:extraction": "vitest run __tests__/eval/extractionEval.test.ts",
    "eval:extraction:update": "node __tests__/eval/updateBaseline.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "gpt-tokenizer": "^3.4.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "neo4j-driver": "^5.28.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^6.0.227",
    "redis": "^5.12.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.35",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
