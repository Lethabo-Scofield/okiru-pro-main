{
  "name": "okiru-pro",
  "version": "1.0.0",
  "private": true,
  "description": "B-BBEE Compliance and Scorecard Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @okiru/web dev",
    "dev:api": "pnpm --filter @okiru/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @okiru/web build",
    "build:api": "pnpm --filter @okiru/api build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "sync:markdown": "node scripts/sync-shared-markdown.mjs",
    "sync:markdown:check": "node scripts/sync-shared-markdown.mjs --check",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @okiru/api test",
    "test:web": "pnpm --filter rest-express test",
    "test:unit": "pnpm --filter @okiru/api test -- src/utils src/services",
    "test:e2e": "pnpm --filter rest-express test:e2e",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "@types/node": "^20.19.35",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "~0.8.13",
      "tar": ">=7.5.19",
      "minimatch": ">=10.2.1",
      "undici": ">=8.5.0",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "lodash": ">=4.18.0",
      "fast-xml-builder": ">=1.1.7",
      "form-data": ">=4.0.6",
      "adm-zip": ">=0.6.0",
      "brace-expansion": ">=5.0.7",
      "js-yaml": ">=4.3.0",
      "sharp": ">=0.35.4",
      "ip-address": ">=10.3.1",
      "browserslist": ">=4.28.7",
      "smol-toml": ">=1.7.1",
      "postcss": ">=8.5.12",
      "nanoid": ">=5.1.16",
      "vite": "7.3.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
