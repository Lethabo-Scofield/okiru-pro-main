 "tblESDData": {
  "sheet": "ESD Data",
  "inputs": [
   "Data Date",
   "Pillar",
   "Beneficiary Name",
   "Current Black ownership %",
   "Current Size",
   "Contribution Description*",
   "Date of Transaction * (format: dd/mm/yyyy)",
   "Stock brokers, Fund managers or Intermediaries? (Yes/No)",
   "Contribution Type",
   "Amount",
   "Invoice date (format: dd/mm/yyyy)",
   "Payment date (format: dd/mm/yyyy)",
   "Prime Rate",
   "Actual Interest Rate",
   "Province",
   "Business Unit",
   "At least 1 job created?",
   "Graduated to Supplier Development?",
   "Initiative",
   "New Contribution?"
  ],
  "formulas": {
   "Benefit Factor": "=IF(AND([@[Qualify?]]=\"Yes\",[@[Contribution Type]]=Validation!$AL$4),[@[Benefit Factor\n'[Shorter payments']]],IF(AND(OR([@[Contribution Type]]=Validation!$AL$1,[@[Contribution Type]]=Validation!$AL$2),[@[Qualify?]]=\"Yes\"),[@[Lower insterest Rate / Lower Divident Rate]],XLOOKUP([@[Contribution Type]],'ESD and SED Calcs'!$A$2:$A$33,'ESD and SED Calcs'!$D$2:$D$33,0,0)))",
   "Recognised Amount": "=IF(AND(OR([@[Current Size]]=\"EME\",[@[Current Size]]=\"QSE\"),[@[Current Black ownership %]]>=51%),[@Amount]*[@[Benefit Factor]],\n\nIF(AND(OR([@[Current Size]]=\"EME\",[@[Current Size]]=\"QSE\"),[@[Current Black ownership %]]>=51%,[@[Contribution Type]]=\"Time of employees productively deployed in assisting Enterprise and Supplier Development beneficiaries\"),([@Amount]/160)*[@[Benefit Factor]],\n\n0))",
   "Recognised Contribution Amount Description": "=IF(XLOOKUP([@[Contribution Type]],'ESD and SED Calcs'!$A$2:$A$33,'ESD and SED Calcs'!$B$2:$B$33,0,0)=0,\"\",XLOOKUP([@[Contribution Type]],'ESD and SED Calcs'!$A$2:$A$33,'ESD and SED Calcs'!$B$2:$B$33,0,0))",
   "Claimable outside FY?": "=IF(OR([@[Contribution Type]]=Validation!$AJ$1,[@[Contribution Type]]=Validation!$AJ$2,[@[Contribution Type]]=Validation!$AJ$3,[@[Contribution Type]]=Validation!$AJ$4,[@[Contribution Type]]=Validation!$AJ$5),\"Yes\",\"No\")",
   "Qualify?": "=IF(AND(OR([@[Current Size]]=\"EME\",[@[Current Size]]=\"QSE\"),[@[Current Black ownership %]]>=51%),\"Yes\",\"No\")",
   "Contribution Type\n[Summary]": "=XLOOKUP([@[Contribution Type]],'ESD and SED Calcs'!$A$1:$A$33,'ESD and SED Calcs'!$C$1:$C$33,0,0)",
   "Number of days\n[inv. Date - pmt. Date]": "=IF(OR([@[Payment date (format: dd/mm/yyyy)]]<[@[Invoice date (format: dd/mm/yyyy)]],([@[Payment date (format: dd/mm/yyyy)]]-[@[Invoice date (format: dd/mm/yyyy)]]>14)),15,[@[Payment date (format: dd/mm/yyyy)]]-[@[Invoice date (format: dd/mm/yyyy)]])",
   "Benefit Factor\n[Shorter payments]": "=IF(OR([@[Invoice date (format: dd/mm/yyyy)]]=\"\",[@[Payment date (format: dd/mm/yyyy)]]=\"\"),0,15%-([@[Number of days\n'[inv. Date - pmt. Date']]]/100))",
   "Benefit Factor\n[Employees time]": "=[@Amount]/160",
   "Lower insterest Rate / Lower Divident Rate": "=[@[Prime Rate]]-[@[Actual Interest Rate]]",
   "SD / ED": "=IF([@Pillar]=\"\",\"\",IF([@Pillar]=\"Enterprise Development\",\"EDGraduation\",[@Pillar]))",
   "Cont": "=IF([@Pillar]=\"\",\"\",IF([@Pillar]=\"Supplier Development\",\"SDCont\",\"EDCont\"))",
   "End of Month": "=EOMONTH([@[Data Date]],0)",
   "Year": "=YEAR([@[End of Month]])",
   "Quarter": "=XLOOKUP([@[End of Month]],Validation!$H$112:$H$123,Validation!$I$112:$I$123,0,0)",
   "Month": "=TEXT([@[End of Month]],\"mmmm\")",
   "Quarter No.": "=RIGHT([@Quarter],1)"
  }
 },
