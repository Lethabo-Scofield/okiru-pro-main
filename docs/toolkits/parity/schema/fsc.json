{
 "tblNorms": {
  "sheet": "Industry Norms",
  "inputs": [
   "Industry"
  ],
  "formulas": {
   "Industry Norms": "=IFERROR(SUMIFS(tblIndustryNorms[Industry Norms],tblIndustryNorms[Industry],[@Industry],\ntblIndustryNorms[Publication date],$C$3),\"0%\")"
  }
 },
 "tblIndustryNorms": {
  "sheet": "Industry Norms",
  "inputs": [
   "Industry",
   "Industry Norms",
   "Publication date"
  ],
  "formulas": {}
 },
 "tblEAPAll": {
  "sheet": "EAP",
  "inputs": [
   "Year",
   "Province",
   "AM",
   "CM",
   "IM",
   "WM",
   "AF",
   "CF",
   "IF",
   "WF"
  ],
  "formulas": {
   "Black %": "=SUM(D37:F37)+SUM(H37:J37)",
   "All %": "=SUM(D37:K37)"
  }
 },
 "tblOwnershipData": {
  "sheet": "Ownership Data",
  "inputs": [
   "Data Date",
   "Shareholder",
   "Ownership Type",
   "SOA Buyer",
   "Transaction (SOA)",
   "Outstaning Debt",
   "Loan Date",
   "BO%",
   "BWO%",
   "BDG%",
   "BNE%",
   "Number of Share",
   "Share Value",
   "Original Date",
   "Exit Date",
   "Date of Tax"
  ],
  "formulas": {
   "Years Held": "=IF([@[Original Date]]=\"\",0,IFERROR(IF([@[Exit Date]]=\"\",DATEDIF([@[Original Date]],[@[Data Date]],\"y\"),DATEDIF([@[Original Date]],[@[Exit Date]],\"y\")),0))",
   "Expiry Date": "=IF(AND([@[Ownership Type]]=\"Continuing Consequences\",[@[Exit Date]]>[@[Original Date]],[@[Years Held]]>=3),\n\nDATE(YEAR([@[Exit Date]]) + [@[Years Held]],MONTH([@[Exit Date]]), DAY([@[Exit Date]])),\"\")",
   "Lock in Date": "=IF(AND([@[Ownership Type]]=\"Sale of Asset\",[@[Date of Tax]]>0),DATE(YEAR([@[Date of Tax]]) + 3, MONTH([@[Date of Tax]]), DAY([@[Date of Tax]])),\"\")",
   "SOA Period (Years)": "=IF(AND([@[Ownership Type]]=\"Sale of Asset\",[@[Date of Tax]]>0),DATEDIF([@[Date of Tax]],[@[Data Date]],\"y\"),\"\")",
   "Loan Term": "=IF([@[Loan Date]]=\"\",\"\",YEARFRAC([@[Loan Date]],[@[Data Date]]))",
   "Share %": "=IFERROR(IF('Ownership Scorecard'!$B$3=Validation!$AP$2,\n(IF([@[End of month]]='Ownership Scorecard'!$I$24,[@[Share Value]]/$M$4,\nIF(AND([@[End of month]]='Ownership Scorecard'!$I$24,[@[Ownership Type]]=\"Continuing Consequences\",[@[Expiry Date]]>[@[Data Date]]),[@[Share Value]]/$M$4,0))),\n\n(IF([@[End of month]]='Ownership Scorecard'!$I$24,[@[Share Value]]/$M$4,\nIF(AND([@[End of month]]='Ownership Scorecard'!$I$24,[@[Ownership Type]]=\"Continuing Consequences\",[@[Expiry Date]]>[@[Data Date]]),[@[Share Value]]/$M$4,0)))),0)",
   "ME BO%": "=V7*H7",
   "ME BWO%": "=V7*I7",
   "ME BDG%": "=V7*J7",
   "ME BNE%": "=V7*K7",
   "Black?": "=IF([@[BO%]]>0,\"Yes\",\"No\")",
   "Debt?": "=IF(AND([@[BO%]]>0,[@[Outstaning Debt]]>0),\"Yes\",\"No\")",
   "Year": "=YEAR([@[Data Date]])",
   "Quarter": "=XLOOKUP([@[End of month]],Validation!$H$28:$H$39,Validation!$I$28:$I$39,0,0)",
   "Month": "=TEXT([@[End of month]],\"mmmm\")",
   "End of month": "=EOMONTH([@[Data Date]],0)",
   "Month No.": "=XLOOKUP([@[End of month]],Validation!H28:H39,Validation!J28:J39,0,0)",
   "Quarter No.": "=RIGHT([@Quarter],1)"
  }
 },
 "tblCompanyValuation": {
  "sheet": "Ownership - Company Value Data",
  "inputs": [
   "Date",
   "Company Asset Value",
   "Total Shares",
   "Share Value"
  ],
  "formulas": {
   "Company Share Value": "=[@[Share Value]]*[@[Total Shares]]",
   "End of month": "=EOMONTH([@Date],0)"
  }
 },
 "tblMCData": {
  "sheet": "MC Data",
  "inputs": [
   "Data Date",
   "Full Name *",
   "Gender *",
   "Race *",
   "Designation *",
   "Disabled *",
   "Foreign *",
   "ID Number",
   "Hire Date \n(format: dd/mm/yyyy)",
   "Termination Date \n(format: dd/mm/yyyy)",
   "Age",
   "Voting Rights (Directors only) *",
   "Termination Reason",
   "Performance Score",
   "Monthly Salary",
   "OFO Code",
   "Position Title",
   "Job Grade",
   "Province",
   "Business Unit",
   "Employee Code"
  ],
  "formulas": {
   "Females?": "=IF([@[Gender '[Verified']]]=\"Female\",\"Yes\",\"No\")",
   "Gender.calcs": "=TRIM([@[Gender *]])",
   "Race.calcs": "=TRIM([@[Race *]])",
   "Designation.calcs": "=TRIM([@[Designation *]])",
   "Disabled.calcs": "=IF(TRIM([@[Disabled *]])=\"\",\"No\",TRIM([@[Disabled *]]))",
   "Foreign.calcs": "=IF(TRIM([@[Foreign *]])=\"\",\"No\",TRIM([@[Foreign *]]))",
   "ID Number.calcs": "=VALUE([@[ID Number]])",
   "Gaps?": "=IF(SUM(tblMCData[@[Gaps.gend]:[Gaps.fore]])>0,\"Yes\",\"No\")",
   "Gaps.gend": "=LEN([@[Gender *]])-LEN(TRIM([@[Gender *]]))",
   "Gaps.race": "=LEN([@[Race *]])-LEN(TRIM([@[Race *]]))",
   "Gaps.desig": "=LEN([@[Designation *]])-LEN(TRIM([@[Designation *]]))",
   "Gaps.disab": "=LEN([@[Disabled *]])-LEN(TRIM([@[Disabled *]]))",
   "Gaps.fore": "=LEN([@[Foreign *]])-LEN(TRIM([@[Foreign *]]))",
   "ID No. / Gender Not Matching?": "=IF(AND([@[Gender '[Verified']]]=[@[Gender.calcs]],[@[Gender '[Verified']]]<>\"\"),\"Yes\",IF(AND([@[Gender '[Verified']]]<>[@[Gender.calcs]],[@[Gender '[Verified']]]<>\"\"),\"No\",\"\"))",
   "Gender [Verified]": "=IF([@[Foreign '[Verified']?]]=\"Yes\",[@[Gender.calcs]],IF(MID([@[ID Num '[Verified']]],7,1)>=\"5\",\"Male\",IF(AND(MID([@[ID Num '[Verified']]],7,1)<\"5\",MID([@[ID Num '[Verified']]],7,1)>\"0\"),\"Female\",[@[Gender *]])))",
   "Foreign [Verified]?": "=IF(OR([@[Passport?]]=\"Yes\",[@[Blank ID?]]=\"Yes\",[@[ID Num '[11-12th Digits']]]=\"18\"),\"Yes\",\"No\")",
   "Passport?": "=IF(ISTEXT([@[ID Number.calcs]]),\"Yes\",\"No\")",
   "Blank ID?": "=IF([@[ID Number.calcs]]=\"\",\"Yes\",\"No\")",
   "ID Num [11-12th Digits]": "=IF(OR([@[Passport?]]=\"No\",[@[Blank ID?]]=\"No\"),MID([@[ID Num '[Verified']]],11,2),\"\")",
   "ID Num [Verified]": "=IF(OR([@[Passport?]]=\"Yes\",[@[Blank ID?]]=\"Yes\"),\"\",TEXT([@[ID Number]],\"0000000000000\"))",
   "Females [Incorrect]": "=IF(AND([@[Gender.calcs]]=\"Female\",[@[Gender '[Verified']]]=\"Male\"),\"Yes\",\"No\")",
   "Males [Incorrect]": "=IF(AND([@[Gender *]]=\"Male\",[@[Gender '[Verified']]]=\"Female\"),\"Yes\",\"No\")",
   "Board?": "=IF(AND(OR([@[Designation.calcs]]=\"Non-executive Director\",[@[Designation.calcs]]=\"Executive Director\")),\"Yes\",\"No\")",
   "Senior/Executive?": "=IF(OR([@[Designation.calcs]]=\"Senior Manager\",[@[Designation.calcs]]=\"Other Executive Manager\"),\"Yes\",\"No\")",
   "Non-Management?": "=IF(OR([@[Designation.calcs]]=\"Semi-skilled\",[@[Designation.calcs]]=\"Unskilled\"),\"Yes\",\"No\")",
   "Black?": "=IF(AND(OR([@[Race.calcs]]=\"Indian\",[@[Race.calcs]]=\"African\",[@[Race.calcs]]=\"Coloured\"),[@[Foreign.calcs]]<>\"Yes\"),\"Yes\",\"No\")",
   "Employee?": "=IF([@[Designation.calcs]]<>\"Non-executive Director\",\"Yes\",\"No\")",
   "Year": "=YEAR([@[Data Date]])",
   "Quarter": "=\"Quarter \"&ROUNDUP(MONTH([@[Data Date]])/3,0)",
   "Q Num": "=ROUNDUP(MONTH([@[Data Date]])/3,0)",
   "Month Num": "=MONTH([@[Data Date]])",
   "Month": "=TEXT([@[Data Date]],\"mmmm\")",
   "Last Day of Quarter": "=EOMONTH([@[Data Date]],MOD(3-MONTH([@[Data Date]]),3))",
   "End of Month": "=EOMONTH([@[Data Date]],0)"
  }
 },
 "tblSkillsData": {
  "sheet": "Skills Data",
  "inputs": [
   "Data Date",
   "Training Program Name *",
   "Category *",
   "ABET",
   "Mandatory Training?",
   "Training Provider",
   "Municipality",
   "Learner Name *",
   "ID Number",
   "Gender *",
   "Race *",
   "Disabled?*",
   "Foreign?*",
   "Management Position *",
   "Age",
   "Employed?",
   "Y.E.S. Employee?",
   "Completed?",
   "Absorbed?",
   "Course Cost",
   "Travel Cost",
   "Accommodation Cost",
   "Catering Cost",
   "Stationery Cost",
   "Training Facility Cost",
   "Salary Cost (category BCD only)",
   "Other Costs",
   "Start Date (format: dd/mm/yyyy)",
   "End Date (format: dd/mm/yyyy)",
   "Custom Data",
   "Man hours",
   "Province",
   "Business Unit",
   "Employee Code",
   "Quarter",
   "Month No."
  ],
  "formulas": {
   "Category.calcs": "=TRIM([@[Category *]])",
   "Gender.calcs": "=TRIM([@[Gender *]])",
   "Race.calcs": "=TRIM([@[Race *]])",
   "Disabled.calcs": "=TRIM([@[Disabled?*]])",
   "Foreign.calcs": "=IF(AND(TRIM([@[Foreign?*]])=\"\",[@[Data Date]]<>\"\"),\"No\",TRIM([@[Foreign?*]]))",
   "Management Position.calcs": "=TRIM([@[Management Position *]])",
   "Employed.calcs": "=TRIM([@[Employed?]])",
   "Y.E.S. Employee.calcs": "=IF(AND(TRIM([@[Y.E.S. Employee?]])=\"\",[@[Data Date]]<>\"\"),\"No\",TRIM([@[Y.E.S. Employee?]]))",
   "Completed.calcs": "=IF(AND(TRIM([@[Completed?]])=\"\",[@[Data Date]]<>\"\"),\"No\",TRIM([@[Completed?]]))",
   "Absorbed.calcs": "=IF(AND(TRIM([@[Absorbed?]])=\"\",[@[Data Date]]<>\"\"),\"No\",TRIM([@[Absorbed?]]))",
   "ID No. / Gender Not Matching?": "=IF(AND([@[Gender '[Verified']]]=[@[Gender.calcs]],[@[Gender '[Verified']]]<>\"\"),\"Yes\",IF(AND([@[Gender '[Verified']]]<>[@[Gender.calcs]],[@[Gender '[Verified']]]<>\"\"),\"No\",\"\"))",
   "Gaps?": "=IF(SUM(tblSkillsData[@[Gategory.gaps]:[Absorbed.gaps]])>0,\"Yes\",\"No\")",
   "Gategory.gaps": "=LEN([@[Category *]])-LEN(TRIM([@[Category *]]))",
   "Gender.gaps": "=LEN([@[Gender *]])-LEN(TRIM([@[Gender *]]))",
   "Race.gaps": "=LEN([@[Race *]])-LEN(TRIM([@[Race *]]))",
   "Disabled.gaps": "=LEN([@[Disabled?*]])-LEN(TRIM([@[Disabled?*]]))",
   "Foreign.gaps": "=LEN([@[Foreign?*]])-LEN(TRIM([@[Foreign?*]]))",
   "Employment.gaps": "=LEN([@[Employed?]])-LEN(TRIM([@[Employed?]]))",
   "YES.gaps": "=LEN([@[Y.E.S. Employee?]])-LEN(TRIM([@[Y.E.S. Employee?]]))",
   "Completed.gaps": "=LEN([@[Completed?]])-LEN(TRIM([@[Completed?]]))",
   "Absorbed.gaps": "=LEN([@[Absorbed?]])-LEN(TRIM([@[Absorbed?]]))",
   "Start Date": "=IF([@[Start Date (format: dd/mm/yyyy)]]=\"\",Validation!C2,[@[Start Date (format: dd/mm/yyyy)]])",
   "End Date": "=IFERROR(IF([@[End Date (format: dd/mm/yyyy)]]=\"\",EOMONTH(DATE(YEAR([@[Start Date]])+1, MONTH([@[Start Date]]), DAY([@[Start Date]])),0),[@[End Date (format: dd/mm/yyyy)]])-1,[@[End Date (format: dd/mm/yyyy)]])",
   "Prior Year": "=IF(AND([@[Data Date]]>0,[@[End of month]]<Validation!C2),\"Yes\",\"No\")",
   "Within FY?": "=IF(AND([@[Data Date]]>0,[@[End of month]]>=Validation!C2),\"Yes\",\"No\")",
   "Started Within FY?": "=IF(OR([@[Start Date]]>=Validation!C2,[@[Start Date]]<=Validation!D2),\"Yes\",\"No\")",
   "Completed Within FY?": "=IF(AND([@[End Date]]>=Validation!C2,[@[End Date]]<=Validation!D2),\"Yes\",\"No\")",
   "Black": "=IF([@[Data Date]]=\"\",\"\",IF(AND([@[Foreign.calcs]]=\"No\",OR([@[Race.calcs]]=\"African\",[@[Race.calcs]]=\"Coloured\",[@[Race.calcs]]=\"Indian\")),\"Yes\",\"No\"))",
   "Black Females?": "=IF([@[Data Date]]=\"\",\"\",IF(AND([@Black]=\"Yes\",[@[Gender.calcs]]=\"Female\"),\"Yes\",\"No\"))",
   "Africans?": "=IF([@[Data Date]]=\"\",\"\",IF(AND([@Black]=\"Yes\",[@[Race.calcs]]=\"African\"),\"Yes\",\"No\"))",
   "Gender [Verified]": "=IF([@[Data Date]]=\"\",\"\",IF(OR(ISTEXT([@[ID Number]]),[@[ID Number]]=\"\"),[@[Gender *]],IF(MID([@[ID Number]],7,1)>=\"5\",\"Male\",\"Female\")))",
   "Foreign? [Verified]": "=IF([@[Data Date]]=\"\",\"\",IF(LEFT(RIGHT([@[ID Number '[Verified']]],3),2)=\"08\",\"No\",\"Yes\"))",
   "ID Number [Verified]": "=IF([@[ID Number]]=\"\",\"\",VALUE([@[ID Number]]))",
   "Age [Verified]": "=IFERROR(ROUNDDOWN((TODAY()-(MID(TEXT([@[ID Number '[Verified']]],\"0000000000000\"),5,2)&\"/\"&MID(TEXT([@[ID Number '[Verified']]],\"0000000000000\"),3,2)&\"/\"&MID(TEXT([@[ID Number '[Verified']]],\"0000000000000\"),1,2)))/365.25,0),\"\")",
   "Non-Management?": "=IF([@[Data Date]]=\"\",\"\",IF(OR([@[Management Position.calcs]]=\"Semi-skilled\",[@[Management Position.calcs]]=\"Unskilled\"),\"Yes\",\"No\"))",
   "Senior & Executives": "=IF([@[Data Date]]=\"\",\"\",IF(OR([@[Management Position.calcs]]=\"Senior Management\",[@[Management Position.calcs]]=\"Executive Management\"),\"Yes\",\"No\"))",
   "LAI": "=IF([@[Data Date]]=\"\",\"\",IF(OR([@[Category.calcs]]=\"B\",[@[Category.calcs]]=\"C\",[@[Category.calcs]]=\"D\"),\"Yes\",\"No\"))",
   "Completed LAI (Unemployed)": "=IF([@[Data Date]]=\"\",\"\",IF(AND([@LAI]=\"Yes\",[@[Completed.calcs]]=\"Yes\",[@[Employed.calcs]]=\"No\"),\"Yes\",\"No\"))",
   "Absorbed LAI [Unemployed]": "=IF([@[Data Date]]=\"\",\"\",IF(AND([@[Completed LAI (Unemployed)]]=\"Yes\",[@[Absorbed.calcs]]=\"Yes\"),\"Yes\",\"No\"))",
   "Cat A-F Spend": "=IF([@[Data Date]]=\"\",\"\",IF([@[Category.calcs]]=\"G\",0,[@[Course Cost]]))",
   "Salaries (BCD)": "=IF([@[Data Date]]=\"\",\"\",IF([@LAI]=\"Yes\",[@[Salary Cost (category BCD only)]],0))",
   "Cat G Spend": "=IF([@[Data Date]]=\"\",\"\",IF([@[Category.calcs]]=\"G\",SUM([@[Course Cost]],[@[Travel Cost]],[@[Accommodation Cost]],[@[Catering Cost]],[@[Stationery Cost]],[@[Training Facility Cost]],[@[Other Costs]]),0))",
   "Other Legitimate Cost": "=IF([@[Data Date]]=\"\",\"\",IF(OR([@[Category.calcs]]=\"A\",[@[Category.calcs]]=\"G\"),0,SUM([@[Travel Cost]],[@[Accommodation Cost]],[@[Catering Cost]],[@[Stationery Cost]],[@[Training Facility Cost]],[@[Other Costs]])))",
   "All Spend": "=IF([@[Data Date]]=\"\",\"\",SUM(tblSkillsData[@[Cat A-F Spend]:[Other Legitimate Cost]]))",
   "Year": "=IF([@[Data Date]]=\"\",\"\",YEAR([@[End of month]]))",
   "Month": "=IF([@[Data Date]]=\"\",\"\",TEXT([@[End of month]],\"mmmm\"))",
   "End of month": "=IF([@[Data Date]]=\"\",\"\",EOMONTH([@[Data Date]],0))",
   "Quarter No.": "=RIGHT([@Quarter],1)"
  }
 },
 "tblPPData": {
  "sheet": "Procurement Data",
  "inputs": [
   "Company Size\n[Scenario]",
   "B-BBEE Level\n[Scenario]",
   "Black Ownership\n[Scenario]",
   "Black Female ownership\n[Scenario]",
   "Black Designated Group  ownership\n[Scenario]",
   "Supplier development recipient? (Yes/No)\n[Scenario]",
   "3 year contract in place? (Yes/No)\n[Scenario]",
   "First-time supplier? (Yes/No)\n[Scenario]",
   "Data Date",
   "Supplier Name *",
   "Current Company Size *",
   "B-BBEE Level",
   "VAT Number",
   "Empowering Supplier? (Yes/No)",
   "Current Black ownership",
   "Current Black Female ownership",
   "Black Designated Group  ownership",
   "Supplier development recipient? (Yes/No)",
   "3 year contract in place? (Yes/No)3",
   "First-time supplier? (Yes/No)",
   "Stock broker? (Yes/No)",
   "Fund manager? (Yes/No)",
   "Intermediary? (Yes/No)",
   "Spend *",
   "Location",
   "Business Unit",
   "Certificate Expiry Date (format: dd/mm/yyyy)",
   "All Spend\nadjusted",
   "Quarter",
   "Month No."
  ],
  "formulas": {
   "All Spend adjusted \nPLUS x1.2 Factor": "=IF(OR([@[Qualify for 1.2 Recognition factor?\n'[SD beneficiariary']]]=\"Yes\",[@[Qualify for 1.2 Recognition factor?\n'[3-year Contract']]]=\"Yes\",[@[Qualify for 1.2 Recognition factor?\n'[First-Time Supplier']]]=\"Yes\"),[@[All Spend\nadjusted]]*1.2,[@[All Spend\nadjusted]])",
   "QSE Spend": "=IF([@[Company Size\n'[Scenario'].Calcs]]=\"QSE\",[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "EME Spend": "=IF([@[Company Size\n'[Scenario'].Calcs]]=\"EME\",[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "BO Spend": "=IF([@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "BWO Spend": "=IF([@[Black Female ownership\n'[Scenario'].Calcs]]>=30%,[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "BDG Spend": "=IF(AND([@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Black Designated Group  ownership\n'[Scenario'].Calcs]]>=51%),[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "Total Stock Brokers Spend": "=IF(AND([@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Stock broker? (Yes/No)]]=\"Yes\"),\n[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "Total Fund Manager Spend": "=IF(AND([@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Fund manager? (Yes/No)]]=\"Yes\"),\n[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "Total Intermediated Spend": "=IF(AND([@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Intermediary? (Yes/No)]]=\"Yes\"),\n[@[All Spend adjusted \nPLUS x1.2 Factor]],0)",
   "Qualify for 1.2 Recognition factor?\n[SD beneficiariary]": "=IF(AND(OR([@[Company Size\n'[Scenario'].Calcs]]=\"QSE\",[@[Company Size\n'[Scenario'].Calcs]]=\"EME\"),[@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Supplier development recipient? (Yes/No)\n'[Scenario'].Calcs]]=\"Yes\"),\"Yes\",\"No\")",
   "Qualify for 1.2 Recognition factor?\n[3-year Contract]": "=IF(AND(OR([@[Company Size\n'[Scenario'].Calcs]]=\"QSE\",[@[Company Size\n'[Scenario'].Calcs]]=\"EME\"),[@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[Supplier development recipient? (Yes/No)\n'[Scenario'].Calcs]]=\"No\",[@[3 year contract in place? (Yes/No)\n'[Scenario'].Calcs]]=\"Yes\"),\"Yes\",\"No\")",
   "Qualify for 1.2 Recognition factor?\n[First-Time Supplier]": "=IF(AND(OR([@[Company Size\n'[Scenario'].Calcs]]=\"QSE\",[@[Company Size\n'[Scenario'].Calcs]]=\"EME\"),[@[Black Ownership\n'[Scenario'].Calcs]]>=51%,[@[First-time supplier? (Yes/No)\n'[Scenario'].Calcs]]=\"Yes\"),\"Yes\",\"No\")",
   "Company Size\n[Scenario].Calcs": "=IF([@[Company Size\n'[Scenario']]]=\"\",[@[Current Company Size *]],[@[Company Size\n'[Scenario']]])",
   "B-BBEE Level\n[Scenario].Calcs": "=IF([@[B-BBEE Level\n'[Scenario']]]=\"\",[@[B-BBEE Level]],[@[B-BBEE Level\n'[Scenario']]])",
   "Black Ownership\n[Scenario].Calcs": "=IF([@[Black Ownership\n'[Scenario']]]=\"\",[@[Current Black ownership]],[@[Black Ownership\n'[Scenario']]])",
   "Black Female ownership\n[Scenario].Calcs": "=IF([@[Black Female ownership\n'[Scenario']]]=\"\",[@[Current Black Female ownership]],[@[Black Female ownership\n'[Scenario']]])",
   "Black Designated Group  ownership\n[Scenario].Calcs": "=IF([@[Black Designated Group  ownership\n'[Scenario']]]=\"\",[@[Black Designated Group  ownership]],[@[Black Designated Group  ownership\n'[Scenario']]])",
   "Supplier development recipient? (Yes/No)\n[Scenario].Calcs": "=IF([@[Supplier development recipient? (Yes/No)\n'[Scenario']]]=\"\",[@[Supplier development recipient? (Yes/No)]],[@[Supplier development recipient? (Yes/No)\n'[Scenario']]])",
   "3 year contract in place? (Yes/No)\n[Scenario].Calcs": "=IF([@[3 year contract in place? (Yes/No)\n'[Scenario']]]=\"\",[@[3 year contract in place? (Yes/No)3]],[@[3 year contract in place? (Yes/No)\n'[Scenario']]])",
   "First-time supplier? (Yes/No)\n[Scenario].Calcs": "=IF([@[First-time supplier? (Yes/No)\n'[Scenario']]]=\"\",[@[3 year contract in place? (Yes/No)3]],[@[First-time supplier? (Yes/No)\n'[Scenario']]])",
   "Dilutive?": "=IF(OR([@[B-BBEE Level\n'[Scenario'].Calcs]]=7,[@[B-BBEE Level\n'[Scenario'].Calcs]]=8,[@[B-BBEE Level\n'[Scenario'].Calcs]]=\"Non-compliant\",[@[B-BBEE Level\n'[Scenario'].Calcs]]=\"\"),\"Yes\",\"No\")",
   "Year": "=YEAR([@[End of month]])",
   "Month": "=TEXT([@[End of month]],\"mmmm\")",
   "End of month": "=IFERROR(EOMONTH([@[Data Date]],0),0)",
   "Quarter No.": "=RIGHT([@Quarter],1)",
   "No BO & No BWO": "=IF(AND([@[BO Spend]]=0,[@[BWO Spend]]=0),\"Yes\",\"No\")",
   "LevelCalcs": "=IF(OR([@[B-BBEE Level]]=\"Non-compliant\",[@[B-BBEE Level]]=\"\"),9,[@[B-BBEE Level]])"
  }
 },
